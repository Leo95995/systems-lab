; config che posso inserire in /etc/systemd/system

[Unit]
Description=Simple health check
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/service_health_check.sh
Restart=always
RestartSec=1s
; set user root for writing in var log directory
User=root

[Install]
WantedBy=multi-user.target